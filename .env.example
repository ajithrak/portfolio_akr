# Firebase config for the site's visit/contact counters (Footer component).
# Copy this file to .env.local and fill in real values from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
# .env.local is gitignored — never commit real values.
# Also add the same VITE_FIREBASE_* variables in Vercel Project Settings > Environment Variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
